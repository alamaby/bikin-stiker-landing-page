# bikin-stiker-landing-page environment variables

# Required before production deploy
SUPABASE_PROJECT_REF=         # e.g. abcdefghij
APPLE_TEAM_ID=                # e.g. ABCDE12345 (found in Apple Developer Portal)
APPLE_BUNDLE_ID=             # e.g. com.alamaby.bikin_stiker
NEXT_PUBLIC_IOS_APP_URL=     # App Store URL e.g. https://apps.apple.com/app/idXXXXXXXXXX

# Required for SEO and CTAs
NEXT_PUBLIC_SITE_URL=https://bikinstiker.alamaby.com
NEXT_PUBLIC_APP_DOWNLOAD_URL=https://play.google.com/store/apps/details?id=com.alamaby.bikin_stiker
