# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.pem

# editors / IDE
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# generated vercel config (built from vercel.json.in via prebuild)
# keep vercel.json.in tracked, never commit generated vercel.json
/vercel.json

# generated .well-known files (built from *.in templates via prebuild)
# keep *.in templates tracked, never commit generated output
public/.well-known/apple-app-site-association
public/.well-known/assetlinks.json

# typescript
*.tsbuildinfo
next-env.d.ts
